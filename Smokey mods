-- ============================================================
-- PLAYER BOXES AND TRACERS (local visualization)
-- Draws a box around other players and lines from your character's
-- head to each of them. Rendered only on this client.
-- ============================================================
do
    local cfg = {
        box = false, tracers = false, labels = false,
        teamColors = false, rainbow = false, bottomOrigin = false,
        boxThickness = 0.05, lineWidth = 2, maxDistance = 2000,
        color = Color3.fromRGB(82, 205, 255),
    }

    local boxFolder = make("Folder", { Name = "SmokeMods_PlayerBoxes" }, gui)
    local lineLayer = make("Frame", {
        Name = "SmokeMods_Tracers",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Active = false,
        ZIndex = 0,
    }, gui)

    local boxes, lines, labels = {}, {}, {}

    local function dropBox(plr)
        if boxes[plr] then boxes[plr]:Destroy() boxes[plr] = nil end
    end
    local function dropTracer(plr)
        if lines[plr] then lines[plr]:Destroy() lines[plr] = nil end
        if labels[plr] then labels[plr]:Destroy() labels[plr] = nil end
    end
    local function dropAll()
        for plr in pairs(boxes) do dropBox(plr) end
        for plr in pairs(lines) do dropTracer(plr) end
    end

    local function colorFor(plr)
        if cfg.rainbow then
            return Color3.fromHSV((rainbowClock * 0.2) % 1, 0.8, 1)
        end
        if cfg.teamColors and plr.Team then
            return plr.TeamColor.Color
        end
        return cfg.color
    end

    table.insert(connections, RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        local character = getCharacter()
        local myRoot = getRoot()
        local myHead = character and character:FindFirstChild("Head")
        local viewSize = gui.AbsoluteSize
        local active = cfg.box or cfg.tracers

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local char = plr.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local distance = (root and myRoot) and (root.Position - myRoot.Position).Magnitude or 0
                local visible = active and root ~= nil and camera ~= nil and distance <= cfg.maxDistance
                local color = visible and colorFor(plr) or cfg.color

                -- Box around the whole character.
                if visible and cfg.box then
                    local box = boxes[plr]
                    if not box then
                        box = make("SelectionBox", { SurfaceTransparency = 0.9 }, boxFolder)
                        boxes[plr] = box
                    end
                    box.Adornee = char
                    box.Color3 = color
                    box.SurfaceColor3 = color
                    box.LineThickness = cfg.boxThickness
                else
                    dropBox(plr)
                end

                -- Line from your head to the player.
                local drawn = false
                if visible and cfg.tracers then
                    local target = camera:WorldToScreenPoint(root.Position)
                    if target.Z > 0 then
                        local originX, originY = viewSize.X / 2, viewSize.Y
                        if not cfg.bottomOrigin and myHead then
                            local origin = camera:WorldToScreenPoint(myHead.Position)
                            if origin.Z > 0.5 then originX, originY = origin.X, origin.Y end
                        end
                        local dx, dy = target.X - originX, target.Y - originY
                        local length = math.sqrt(dx * dx + dy * dy)

                        local line = lines[plr]
                        if not line then
                            line = make("Frame", {
                                AnchorPoint = Vector2.new(0.5, 0.5),
                                BorderSizePixel = 0,
                                Active = false,
                            }, lineLayer)
                            lines[plr] = line
                        end
                        line.Visible = true
                        line.BackgroundColor3 = color
                        line.Position = UDim2.fromOffset((originX + target.X) / 2, (originY + target.Y) / 2)
                        line.Size = UDim2.fromOffset(length, cfg.lineWidth)
                        line.Rotation = math.deg(math.atan2(dy, dx))
                        drawn = true

                        if cfg.labels then
                            local label = labels[plr]
                            if not label then
                                label = make("TextLabel", {
                                    AnchorPoint = Vector2.new(0.5, 1),
                                    Size = UDim2.fromOffset(160, 16),
                                    BackgroundTransparency = 1,
                                    Font = Enum.Font.GothamBold,
                                    TextSize = 11,
                                    TextStrokeTransparency = 0.4,
                                    Active = false,
                                }, lineLayer)
                                labels[plr] = label
                            end
                            label.Visible = true
                            label.TextColor3 = color
                            label.Position = UDim2.fromOffset(target.X, target.Y - 6)
                            label.Text = string.format("%s  %d studs", plr.DisplayName, distance)
                        elseif labels[plr] then
                            labels[plr].Visible = false
                        end
                    end
                end
                if not drawn then
                    if lines[plr] then lines[plr].Visible = false end
                    if labels[plr] then labels[plr].Visible = false end
                    if not cfg.tracers then dropTracer(plr) end
                end
            end
        end
    end))

    table.insert(connections, Players.PlayerRemoving:Connect(function(plr)
        dropBox(plr)
        dropTracer(plr)
    end))

    local function setColor(color)
        cfg.color = color
        cfg.rainbow = false
    end

    addExtraGroup(visuals, "Player boxes and tracers", {
        {name="Box ESP: box around every player", run=function(v) cfg.box = v end,
            description="Draws a box around each other player's character."},
        {name="Tracers: lines from your head to players", run=function(v) cfg.tracers = v end,
            description="One line from your head to every other player."},
        {name="Tracers: show name and distance", run=function(v) cfg.labels = v end},
        {name="Tracers: start at bottom of screen", run=function(v) cfg.bottomOrigin = v end},
        {name="Colors: use team colors", run=function(v) cfg.teamColors = v end},
        {name="Colors: rainbow", run=function(v) cfg.rainbow = v end},
        {name="Color: cyan", kind="button", run=function() setColor(Color3.fromRGB(82, 205, 255)) end},
        {name="Color: purple", kind="button", run=function() setColor(Color3.fromRGB(171, 92, 255)) end},
        {name="Color: green", kind="button", run=function() setColor(Color3.fromRGB(88, 220, 155)) end},
        {name="Color: red", kind="button", run=function() setColor(Color3.fromRGB(255, 100, 125)) end},
