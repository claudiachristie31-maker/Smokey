local selectedLabel = make("TextLabel", {
    Size = UDim2.new(1, -4, 0, 38),
    BackgroundColor3 = Theme.Surface,
    BorderSizePixel = 0,
    Text = "Selected player: none",
    TextColor3 = Theme.Text,
    Font = Enum.Font.GothamMedium,
    TextSize = 10,
    TextWrapped = true,
}, playersPage)
corner(selectedLabel, 9)

local function updateSelectedLabel()
    selectedLabel.Text = "Selected player: " .. (selectedPlayer and
        (selectedPlayer.DisplayName .. "  (@" .. selectedPlayer.Name .. ")") or "none")
end

local function selectNextPlayer()
    local candidates = {}
    for _, candidate in ipairs(Players:GetPlayers()) do
        if candidate ~= player then table.insert(candidates, candidate) end
    end
    table.sort(candidates, function(a, b) return a.Name < b.Name end)
    if #candidates == 0 then
        selectedPlayer = nil
    else
        local index = table.find(candidates, selectedPlayer) or 0
        selectedPlayer = candidates[index % #candidates + 1]
    end
    updateSelectedLabel()
    if selectedPlayer then toast("Selected " .. selectedPlayer.DisplayName) end
end

