-- Live HUD and animated accent. Text refresh is throttled to reduce UI churn.
local hudRefreshElapsed = 0
table.insert(connections, RunService.RenderStepped:Connect(function(dt)
    hudRefreshElapsed += dt
    fpsTimer += dt
    frameCounter += 1
    if fpsTimer >= 0.5 then
        fps = math.floor(frameCounter / fpsTimer)
        frameCounter = 0
        fpsTimer = 0
    end

    rainbowClock += dt
    if State.rainbow then
        local color = Color3.fromHSV((rainbowClock * 0.12) % 1, 0.72, 1)
        mainStroke.Color = color
        accentBar.BackgroundColor3 = color
    else
        mainStroke.Color = Theme.Accent
        accentBar.BackgroundColor3 = Theme.Accent
    end

    if hudRefreshElapsed < 0.25 then return end
    hudRefreshElapsed = 0
    local lines = {"SMOKE MODS  /  LIVE"}
    if State.showFps then table.insert(lines, "FPS: " .. tostring(fps)) end
    if State.showCoords then
        local root = getRoot()
        table.insert(lines, "XYZ: " .. (root and string.format("%d, %d, %d",
            root.Position.X, root.Position.Y, root.Position.Z) or "n/a"))
    end
    if State.showClock then
        table.insert(lines, "SESSION: " .. math.floor(os.clock() - startedAt) .. "s")
    end
    if State.showPlayers then
        table.insert(lines, "PLAYERS: " .. #Players:GetPlayers())
    end
    hudText.Text = table.concat(lines, "\n")
    hud.Visible = State.showFps or State.showCoords or State.showClock or State.showPlayers
    crosshair.Visible = State.crosshair
end))

-- Lifecycle cleanup and respawn support.
local function onCharacterAdded()
    task.wait(0.35)
    applyMovement()
    if State.fly then startFly() end
    if State.noclip then startNoclip() end
    if workspace.CurrentCamera then
        workspace.CurrentCamera.FieldOfView = settings.fov
    end
    if State.esp or State.nameEsp then
        task.wait(0.2)
        refreshVisuals()
    end
end

table.insert(connections, player.CharacterAdded:Connect(onCharacterAdded))
table.insert(connections, Players.PlayerAdded:Connect(function(candidate)
    candidate.CharacterAdded:Connect(function()
        task.wait(0.3)
        refreshVisuals()
    end)
    task.wait(0.2)
    refreshVisuals()
end))
table.insert(connections, Players.PlayerRemoving:Connect(function(candidate)
    if selectedPlayer == candidate then
        selectedPlayer = nil
        updateSelectedLabel()
    end
    task.defer(refreshVisuals)
end))
table.insert(connections, player.CharacterRemoving:Connect(function()
    stopAirWalk()
    stopSpin()
    stopFly()
    stopNoclip()
    clearVisuals()
end))


