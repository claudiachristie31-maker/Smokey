        {name="Bloom: softer", kind="button", run=function() tune("BloomEffect", "SmokeMods_Bloom", "Intensity", -0.3, 0, 3, {Size = 30, Threshold = 1.5}) end},
        {name="Blur: wider", kind="button", run=function() tune("BlurEffect", "SmokeMods_Blur", "Size", 4, 0, 40, {Size = 0}) end},
        {name="Blur: narrower", kind="button", run=function() tune("BlurEffect", "SmokeMods_Blur", "Size", -4, 0, 40, {Size = 8}) end},
        {name="Sun rays: stronger", kind="button", run=function() tune("SunRaysEffect", "SmokeMods_SunRays", "Intensity", 0.1, 0, 1, {Intensity = 0.1, Spread = 0.8}) end},
        {name="Sun rays: weaker", kind="button", run=function() tune("SunRaysEffect", "SmokeMods_SunRays", "Intensity", -0.1, 0, 1, {Intensity = 0.3, Spread = 0.8}) end},
        {name="Depth of field: focus nearer", kind="button", run=function() tune("DepthOfFieldEffect", "SmokeMods_DoF", "FocusDistance", -10, 0, 500, {FarIntensity = 0.3, FocusDistance = 40, InFocusRadius = 30, NearIntensity = 0}) end},
        {name="Depth of field: focus farther", kind="button", run=function() tune("DepthOfFieldEffect", "SmokeMods_DoF", "FocusDistance", 10, 0, 500, {FarIntensity = 0.3, FocusDistance = 40, InFocusRadius = 30, NearIntensity = 0}) end},
        {name="Post-processing: remove all", kind="button", run=function()
