local aimPracticeEnabled = false
local aimPracticeConnection
local aimPracticeTarget
local function getTrainingTargets()
    local CollectionService = game:GetService("CollectionService")
    local found = {}
    for _, model in ipairs(CollectionService:GetTagged("AimTrainingTarget")) do
        if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid")
            and model:FindFirstChild("HumanoidRootPart") then
            table.insert(found, model)
        end
    end
    return found
end
toggle(morePage, "NPC training lock-on", false, function(v)
    aimPracticeEnabled = v
    if aimPracticeConnection then aimPracticeConnection:Disconnect(); aimPracticeConnection = nil end
    if v then
        local scanElapsed = 0
        local cachedTargets = getTrainingTargets()
        aimPracticeConnection = RunService.RenderStepped:Connect(function(dt)
            scanElapsed += dt
            if scanElapsed >= 0.2 then
                scanElapsed = 0
                cachedTargets = getTrainingTargets()
            end
            local camera = workspace.CurrentCamera
            if not camera then return end
            local targets = cachedTargets
            local best, bestDistance
            for _, model in ipairs(targets) do
                local root = model:FindFirstChild("HumanoidRootPart")
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if root and humanoid and humanoid.Health > 0 then
                    local _, visible = camera:WorldToViewportPoint(root.Position)
                    if visible then
                        local distance = (root.Position - camera.CFrame.Position).Magnitude
                        if not bestDistance or distance < bestDistance then
                            best, bestDistance = root, distance
                        end
                    end
                end
            end
            if best then
                aimPracticeTarget = best
                local desired = CFrame.lookAt(camera.CFrame.Position, best.Position)
                camera.CFrame = camera.CFrame:Lerp(desired, math.clamp(dt * 5, 0, 0.18))
            end
        end)
        toast("Training lock-on enabled for tagged NPC dummies.")
    else
        aimPracticeTarget = nil
        toast("Training lock-on disabled.")
    end
end, "Only tracks NPC models tagged AimTrainingTarget; never targets real players.")
