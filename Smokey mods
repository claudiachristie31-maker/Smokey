local function recolorMenu(background, surface, accent, accent2)
    Theme.Background = background
    Theme.Surface = surface
    Theme.Surface2 = surface:Lerp(Color3.new(1, 1, 1), 0.10)
    Theme.SurfaceHover = surface:Lerp(Color3.new(1, 1, 1), 0.20)
    Theme.Accent = accent
    Theme.Accent2 = accent2
    main.BackgroundColor3 = background
    header.BackgroundColor3 = surface
    sidebar.BackgroundColor3 = surface
    mainStroke.Color = accent
    accentBar.BackgroundColor3 = accent
    search.BackgroundColor3 = Theme.Surface2
    pageTitle.TextColor3 = Theme.Text
    for _, nav in pairs(navButtons) do
        nav.BackgroundColor3 = Theme.Surface2
        nav.TextColor3 = Theme.Muted
    end
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("Frame") and (obj.BackgroundColor3 == Color3.fromRGB(12, 12, 20)
            or obj.BackgroundColor3 == Color3.fromRGB(23, 22, 36)
            or obj.BackgroundColor3 == Color3.fromRGB(33, 31, 50)) then
            obj.BackgroundColor3 = surface
        elseif obj:IsA("TextLabel") and obj.TextColor3 == Color3.fromRGB(164, 158, 184) then
            obj.TextColor3 = Theme.Muted
        end
    end
    toast("Menu theme updated.")
end

-- Menu style switch: the Coolgui preset recreates the supplied black/red,
-- square-edged look while keeping every existing page and control usable.
local coolguiMode = false
local styleOriginals = nil
local function cacheOriginalStyle()
    if styleOriginals then return end
    styleOriginals = {}
    for _, obj in ipairs(gui:GetDescendants()) do
        local saved = {}
        if obj:IsA("GuiObject") then saved.BackgroundColor3 = obj.BackgroundColor3 end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            saved.TextColor3 = obj.TextColor3
            saved.Font = obj.Font
            saved.TextSize = obj.TextSize
        end
        if obj:IsA("UICorner") then saved.CornerRadius = obj.CornerRadius end
        if obj:IsA("UIStroke") then
            saved.StrokeColor = obj.Color
            saved.StrokeThickness = obj.Thickness
            saved.StrokeTransparency = obj.Transparency
        end
        if next(saved) then styleOriginals[obj] = saved end
    end
end

local function setMenuStyle(mode)
    cacheOriginalStyle()
    coolguiMode = mode == "coolgui"
    if coolguiMode then
        recolorMenu(
            Color3.fromRGB(0, 0, 0),
            Color3.fromRGB(8, 8, 8),
            Color3.fromRGB(255, 0, 0),
            Color3.fromRGB(255, 65, 65)
        )
        Theme.Surface2 = Color3.fromRGB(17, 17, 17)
        Theme.SurfaceHover = Color3.fromRGB(48, 8, 8)
        Theme.Text = Color3.fromRGB(245, 245, 245)
        Theme.Muted = Color3.fromRGB(205, 205, 205)
        main.Size = UDim2.fromOffset(700, 500)
        local title = header:FindFirstChild("Title")
        if title then title.Text = "Coolgui"; title.Font = Enum.Font.Code; title.TextSize = 18 end
        local subtitle
        for _, child in ipairs(header:GetChildren()) do
            if child:IsA("TextLabel") and child ~= title then subtitle = child; break end
        end
        if subtitle then subtitle.Text = "SMOKE MODS  â¢  CLASSIC RED MENU" end
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("UICorner") then
                obj.CornerRadius = UDim.new(0, 0)
            elseif obj:IsA("UIStroke") then
                obj.Color = Color3.fromRGB(255, 0, 0)
                obj.Thickness = 1
                obj.Transparency = 0
            elseif obj:IsA("Frame") then
                if obj == main then
                    obj.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                elseif obj == header or obj == sidebar then
                    obj.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
                elseif obj.BackgroundTransparency < 1 then
                    obj.BackgroundColor3 = Color3.fromRGB(9, 9, 9)
                end
            elseif obj:IsA("TextButton") then
                obj.BackgroundColor3 = Color3.fromRGB(7, 7, 7)
                obj.TextColor3 = Color3.fromRGB(245, 245, 245)
                local outline = obj:FindFirstChildOfClass("UIStroke")
                if not outline then stroke(obj, Color3.fromRGB(255, 0, 0), 1, 0) end
            elseif obj:IsA("TextLabel") then
                obj.Font = Enum.Font.Code
                obj.TextColor3 = Color3.fromRGB(235, 235, 235)
                if obj.TextSize > 12 then obj.TextSize = 12 end
            end
        end
        pageTitle.TextColor3 = Color3.fromRGB(255, 70, 70)
        pageScroll.ScrollBarImageColor3 = Color3.fromRGB(255, 0, 0)
        toast("Coolgui red/black style enabled.")
    else
        for obj, saved in pairs(styleOriginals) do
            if obj and obj.Parent then
                pcall(function()
                    if saved.BackgroundColor3 then obj.BackgroundColor3 = saved.BackgroundColor3 end
                    if saved.TextColor3 then obj.TextColor3 = saved.TextColor3 end
                    if saved.Font then obj.Font = saved.Font end
                    if saved.TextSize then obj.TextSize = saved.TextSize end
                    if saved.CornerRadius then obj.CornerRadius = saved.CornerRadius end
                    if saved.StrokeColor then obj.Color = saved.StrokeColor end
                    if saved.StrokeThickness then obj.Thickness = saved.StrokeThickness end
                    if saved.StrokeTransparency then obj.Transparency = saved.StrokeTransparency end
                end)
            end
        end
        recolorMenu(Color3.fromRGB(12, 12, 20), Color3.fromRGB(23, 22, 36),
            Color3.fromRGB(171, 92, 255), Color3.fromRGB(82, 205, 255))
        Theme.Text = Color3.fromRGB(246, 243, 255)
        Theme.Muted = Color3.fromRGB(164, 158, 184)
        Theme.Surface2 = Color3.fromRGB(33, 31, 50)
        Theme.SurfaceHover = Color3.fromRGB(45, 40, 67)
        main.Size = State.compact and UDim2.fromOffset(560, 420) or UDim2.fromOffset(640, 470)
        local title = header:FindFirstChild("Title")
        if title then title.Text = "SMOKE MODS"; title.Font = Enum.Font.GothamBlack; title.TextSize = 20 end
        local subtitle
        for _, child in ipairs(header:GetChildren()) do
            if child:IsA("TextLabel") and child ~= title then subtitle = child; break end
        end
        if subtitle then subtitle.Text = "NEON OVERDRIVE  â¢  STUDIO TOOLKIT" end
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("UICorner") then
                local parentName = obj.Parent and obj.Parent.Name or ""
                obj.CornerRadius = UDim.new(0, parentName == "Main" and 16 or (parentName == "Header" and 16 or 9))
            elseif obj:IsA("UIStroke") then
                obj.Color = Theme.Accent
                obj.Transparency = 0.1
                obj.Thickness = 1
            elseif obj:IsA("TextLabel") then
                obj.Font = Enum.Font.Gotham
                obj.TextColor3 = Theme.Text
            end
        end
        pageTitle.Font = Enum.Font.GothamBold
        pageTitle.TextSize = 15
        pageScroll.ScrollBarImageColor3 = Theme.Accent
        toast("Neon Overdrive style restored.")
    end
end

