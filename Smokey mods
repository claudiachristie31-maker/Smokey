-- Air-walk platform: a locally-created solid tile follows just beneath the player.
-- This is a Studio/local sandbox feature; it does not create server-side parts.
local airWalkEnabled = false
local airWalkPlatform
local airWalkConnection
local airWalkSize = 8
local airWalkOffset = 3.35

local function removeAirWalkPlatform()
    if airWalkConnection then
        airWalkConnection:Disconnect()
        airWalkConnection = nil
    end
    if airWalkPlatform then
        airWalkPlatform:Destroy()
        airWalkPlatform = nil
    end
end

stopAirWalk = function()
    airWalkEnabled = false
    removeAirWalkPlatform()
end

local function startAirWalk()
    stopAirWalk()
    local root = getRoot()
    if not root then
        toast("Character is not ready.")
        return
    end

    airWalkEnabled = true
    airWalkPlatform = Instance.new("Part")
    airWalkPlatform.Name = "SmokeMods_AirWalkPlatform"
    airWalkPlatform.Size = Vector3.new(airWalkSize, 0.45, airWalkSize)
    airWalkPlatform.Anchored = true
    airWalkPlatform.CanCollide = true
    airWalkPlatform.CanTouch = false
    airWalkPlatform.CanQuery = false
    airWalkPlatform.Material = Enum.Material.Neon
    airWalkPlatform.Color = Theme.Accent2
    airWalkPlatform.Transparency = 0.18
    airWalkPlatform.TopSurface = Enum.SurfaceType.Smooth
    airWalkPlatform.BottomSurface = Enum.SurfaceType.Smooth
    airWalkPlatform.Parent = workspace

    local airWalkElapsed = 0
    airWalkConnection = RunService.Heartbeat:Connect(function(dt)
        airWalkElapsed += dt
        if airWalkElapsed < 0.05 then return end
        airWalkElapsed = 0
        local currentRoot = getRoot()
        if not airWalkEnabled or not currentRoot or not currentRoot.Parent then
            stopAirWalk()
            return
        end
        airWalkPlatform.Size = Vector3.new(airWalkSize, 0.45, airWalkSize)
        airWalkPlatform.CFrame = CFrame.new(
            currentRoot.Position.X,
            currentRoot.Position.Y - airWalkOffset,
            currentRoot.Position.Z
        )
    end)
    toast("Air-walk platform enabled.")
end

local function toggleAirWalk(value)
    if value then
        startAirWalk()
    else
        stopAirWalk()
        toast("Air-walk platform disabled.")
    end
end

