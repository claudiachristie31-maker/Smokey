-- ============================================================
-- VISUALS EXPANSION: sky, atmosphere, color grading, post-processing,
-- render looks, screen overlays and menu look.
-- All changes are local to this client and can be reset from this page.
-- ============================================================
do
    local fogDefaults = {
        FogStart = Lighting.FogStart, FogEnd = Lighting.FogEnd, FogColor = Lighting.FogColor,
    }
    local shadowSoftnessDefault = Lighting.ShadowSoftness
    local terrain = workspace.Terrain
    local waterDefaults = {
        WaterColor = terrain.WaterColor, WaterTransparency = terrain.WaterTransparency,
        WaterWaveSize = terrain.WaterWaveSize, WaterReflectance = terrain.WaterReflectance,
    }

    local function ensureEffect(className, name, props)
        local effect = Lighting:FindFirstChild(name)
        if not effect then
            effect = Instance.new(className)
            effect.Name = name
            for key, value in pairs(props or {}) do effect[key] = value end
            effect.Parent = Lighting
        end
        effect.Enabled = true
        return effect
    end

    local function dropEffect(name)
        local effect = Lighting:FindFirstChild(name)
        if effect then effect:Destroy() end
    end

    local function grade(props)
        local effect = ensureEffect("ColorCorrectionEffect", "SmokeMods_Grade")
        effect.Saturation = 0
        effect.Contrast = 0
        effect.Brightness = 0
        effect.TintColor = Color3.new(1, 1, 1)
        for key, value in pairs(props) do effect[key] = value end
        return effect
    end

    local function ensureAtmosphere()
        local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
        if not atmosphere then
            atmosphere = Instance.new("Atmosphere")
            atmosphere.Name = "SmokeMods_Atmosphere"
            atmosphere.Parent = Lighting
        end
        return atmosphere
    end

    local function ensureSky()
        local sky = Lighting:FindFirstChildOfClass("Sky")
        if not sky then
            sky = Instance.new("Sky")
            sky.Name = "SmokeMods_Sky"
            sky.Parent = Lighting
        end
        return sky
    end

    local function tune(className, name, property, delta, minValue, maxValue, startProps)
        local effect = ensureEffect(className, name, startProps)
        effect[property] = math.clamp(effect[property] + delta, minValue, maxValue)
        toast(string.format("%s: %.2f", property, effect[property]))
    end

    -- Screen overlays live in the Smoke Mods ScreenGui, below the menu.
    local function overlay(name, build)
        local existing = gui:FindFirstChild(name)
        if existing then existing:Destroy() end
        local holder = make("Frame", {
            Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Active = false, ZIndex = 0,
        }, gui)
        build(holder)
        holder.Parent = gui
        return holder
    end
    local function dropOverlay(name)
        local existing = gui:FindFirstChild(name)
        if existing then existing:Destroy() end
    end

    local function tint(name, color, transparency)
        return function(v)
            if not v then dropOverlay(name) return end
            overlay(name, function(holder)
                holder.BackgroundColor3 = color
                holder.BackgroundTransparency = transparency
                holder.BorderSizePixel = 0
            end)
        end
    end

    local breathing
    local function stopBreathing()
