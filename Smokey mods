local soundBound = setmetatable({}, { __mode = "k" })
local function bindButtonSound(object)
    if not object:IsA("GuiButton") or soundBound[object] then return end
    soundBound[object] = true
    object.Activated:Connect(function()
        if uiSoundSettings.click then
            clickSound:Stop()
            clickSound.TimePosition = 0
            clickSound:Play()
        end
    end)
    object.MouseEnter:Connect(function()
        if uiSoundSettings.hover then
            hoverSound:Stop()
            hoverSound.TimePosition = 0
            hoverSound:Play()
        end
    end)
end
