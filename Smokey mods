local function createPage(name)
    local page = make("Frame", {
        Name = name,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        ClipsDescendants = false,
    }, pageScroll)
    make("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)
    pages[name] = page
    return page
end

local function switchPage(name)
    currentPage = name
    pageTitle.Text = string.upper(name)
    search.Text = ""
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
        page.Position = UDim2.fromOffset(0, 0)
    end
    -- Each tab starts at the top, so its buttons can be reached immediately.
    pageScroll.CanvasPosition = Vector2.zero
    for pageName, nav in pairs(navButtons) do
        local active = pageName == name
        nav.BackgroundColor3 = active and Theme.Accent or Theme.Surface2
        nav.TextColor3 = active and Color3.new(1,1,1) or Theme.Muted
    end
end

local function addNav(name, symbol)
