-- Movement helpers
local function applyMovement()
    local humanoid = getHumanoid()
    if not humanoid then return end
    humanoid.WalkSpeed = State.sprint and settings.sprintSpeed or settings.walkSpeed
    humanoid.UseJumpPower = true
