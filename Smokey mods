    }, holder)
    corner(switch, 20)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = enabled and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
    }, switch)
    corner(knob, 20)
    local function paint()
        tween(switch, 0.14, { BackgroundColor3 = enabled and Theme.Accent or Theme.Surface2 })
        tween(knob, 0.14, {
            Position = enabled and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        })
    end
    switch.Activated:Connect(function()
        enabled = not enabled
        paint()
        local ok, err = pcall(callback, enabled)
        if not ok then
            warn("[SMOKE MODS] Toggle '" .. tostring(label) .. "' failed: " .. tostring(err))
            toast("Couldn't toggle: " .. tostring(label))
        end
    end)
    return {
        Set = function(value)
            enabled = value == true
            paint()
            callback(enabled)
        end,
        Get = function() return enabled end,
    }
end

local function slider(page, label, minValue, maxValue, initial, callback)
    local holder = make("Frame", {
        Size = UDim2.new(1, -4, 0, 55),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
    }, page)
    corner(holder, 9)
    local value = initial
    local title = make("TextLabel", {
        Position = UDim2.fromOffset(12, 5),
        Size = UDim2.new(1, -24, 0, 18),
        BackgroundTransparency = 1,
        Text = label .. ": " .. tostring(value),
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)
    local bar = make("TextButton", {
        Position = UDim2.fromOffset(12, 32),
        Size = UDim2.new(1, -24, 0, 9),
        BackgroundColor3 = Theme.Surface2,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, holder)
    corner(bar, 10)
    local fill = make("Frame", {
        Size = UDim2.new((value-minValue)/(maxValue-minValue), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 10)
    local dragging = false
    local function setAt(x)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local percent = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
        value = math.floor(minValue + percent * (maxValue - minValue) + 0.5)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        title.Text = label .. ": " .. tostring(value)
        callback(value)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setAt(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setAt(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return holder
end

