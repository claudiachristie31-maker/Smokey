local hud, hudText, crosshair

local extraFlags = {}
local extraOriginals = {}
local function extraToggle(page, label, callback, description)
    return toggle(page, label, false, function(enabled)
        extraFlags[label] = enabled
        callback(enabled)
    end, description)
end

local function rememberAndSet(object, property, value, key)
    if not object then return end
    key = key or (object:GetFullName() .. ":" .. property)
    if extraOriginals[key] == nil then
        local ok, old = pcall(function() return object[property] end)
        if ok then extraOriginals[key] = { object = object, property = property, value = old } end
    end
    pcall(function() object[property] = value end)
end

local function restoreExtra(key)
    local item = extraOriginals[key]
    if item and item.object and item.object.Parent then
        pcall(function() item.object[item.property] = item.value end)
    end
    extraOriginals[key] = nil
end

local function addExtraGroup(page, heading, entries)
    section(page, heading)
    for _, entry in ipairs(entries) do
        if entry.kind == "button" then
            actionButton(page, entry.name, entry.run, entry.description)
        else
            extraToggle(page, entry.name, entry.run, entry.description)
        end
    end
end

